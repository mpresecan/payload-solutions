DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/payload-solutions
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SITE_URL=https://payload.solutions
# PostHog client analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Transactional email (Resend). Without RESEND_API_KEY contact submissions are stored but not emailed.
# CONTACT_NOTIFY_EMAIL overrides the inbox, which defaults to hello@payload.solutions.
# RESEND_API_KEY=
# CONTACT_NOTIFY_EMAIL=
# Media storage (Cloudflare R2, S3-compatible API). Without R2_BUCKET uploads go to ./media on local
# disk, which Vercel wipes on every deploy. Create an R2 API token with Object Read & Write on the bucket.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Optional: public bucket URL or custom domain, no trailing slash. When set, files are served from
# there instead of through /api/media/file (Payload access control is bypassed for media).
# R2_PUBLIC_URL=https://media.payload.solutions
