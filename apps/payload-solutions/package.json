{
  "name": "@payload-solutions/web",
  "version": "0.1.0",
  "private": true,
  "description": "payload.solutions: products, plugins, roadmap, documentation and services for teams building on Payload CMS.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3200",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3200",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo .source"
  },
  "dependencies": {
    "@payload-solutions/brand": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@phosphor-icons/react": "^2.1.10",
    "cross-env": "^7.0.3",
    "fumadocs-core": "^16.15.6",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.6",
    "geist": "^1.7.2",
    "graphql": "^16.8.1",
    "motion": "^13.2.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "simple-icons": "^16.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
