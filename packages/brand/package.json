    "./tailwind.css": "./css/tailwind.css",
    "./assets/*": "./assets/*"
  },
  "files": ["src", "css", "assets"],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
