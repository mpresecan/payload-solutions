{
  "name": "@payload-solutions/brand",
  "version": "0.1.0",
  "description": "Shared brand system for Payload Solutions, Payload Stack and Payload Clock: logo mark, wordmarks, design tokens and Tailwind theme.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./logos": "./src/logos.tsx",
    "./brands": "./src/brands.ts",
    "./tokens.css": "./css/tokens.css",
    "./tailwind.css": "./css/tailwind.css",
    "./assets/*": "./assets/*",
    "./iso-stack": "./src/iso-stack.tsx",
    "./parallax": "./src/parallax.tsx",
    "./ambient-backdrop": "./src/ambient-backdrop.tsx",
    "./grid-columns": "./src/grid-columns.tsx",
    "./crosshairs": "./src/crosshairs.tsx",
    "./media-stack": "./src/media-stack.tsx",
    "./theme-band": "./src/theme-band.tsx",
    "./themed-image": "./src/themed-image.tsx",
    "./use-header-theme": "./src/use-header-theme.ts",
    "./screens": "./src/screens.ts",
    "./reduced-motion": "./src/reduced-motion.ts"
  },
  "files": [
    "src",
    "css",
    "assets"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "motion": "^13.0.0",
    "next": "^16.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.8",
    "typescript": "^5.9.3",
    "motion": "^13.2.0",
    "next": "^16.3.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
