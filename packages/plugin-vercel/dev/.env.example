# Optional. Defaults to a local SQLite file at dev/dev.db; a postgres:// URL switches the dev app to Postgres.
# DATABASE_URL=file:./dev/dev.db
PAYLOAD_SECRET=change-me
SERVER_URL=http://localhost:3400

# Vercel. Point both at the mock server (`pnpm dev:mock-vercel`, port 3399) to develop without a Vercel account.
VERCEL_DEPLOY_HOOK_PRODUCTION=http://localhost:3399/v1/integrations/deploy/prj_dev000000000000000000/hook_production
VERCEL_DEPLOY_HOOK_STAGING=http://localhost:3399/v1/integrations/deploy/prj_dev000000000000000000/hook_staging
VERCEL_API_BASE=http://localhost:3399
VERCEL_TOKEN=mock-token
# VERCEL_TEAM_ID=team_xxx
# VERCEL_WEBHOOK_SECRET=mock-webhook-secret
# Set to false to stop admin tabs flushing pending windows on close (the e2e suite does this).
# VERCEL_BEACON=false
