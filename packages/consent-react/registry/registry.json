{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "payload-solutions",
  "homepage": "https://payload.solutions",
  "items": [
    {
      "name": "consent-banner",
      "type": "registry:block",
      "title": "Consent banner",
      "description": "Cookie consent banner, preferences dialog and footer link for Payload Consent. Non-modal, accept and reject equally prominent, copy from the Payload admin.",
