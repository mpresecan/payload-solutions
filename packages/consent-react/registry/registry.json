      "registryDependencies": ["button", "dialog", "switch", "accordion", "badge", "label"],
      "files": [
        { "path": "registry/consent-banner/consent-banner.tsx", "type": "registry:component", "target": "components/consent/consent-banner.tsx" },
        { "path": "registry/consent-banner/consent-preferences-dialog.tsx", "type": "registry:component", "target": "components/consent/consent-preferences-dialog.tsx" },
        { "path": "registry/consent-banner/consent-settings-link.tsx", "type": "registry:component", "target": "components/consent/consent-settings-link.tsx" }
      ]
    }
  ]
}
