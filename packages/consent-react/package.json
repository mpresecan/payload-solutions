{
  "name": "@payload-solutions/consent-react",
  "version": "0.1.0",
  "description": "React bindings for Payload Consent: provider, hooks, ConsentGate, consent-gated script loading, Google Consent Mode v2 script and Next.js server helpers.",
  "keywords": [
    "react",
    "nextjs",
    "consent",
    "cookie-consent",
    "gdpr",
    "consent-mode",
    "payload",
    "payloadcms"
  ],
  "license": "MIT",
  "homepage": "https://payload.solutions/docs/plugins/payload-consent",
  "repository": {
    "type": "git",
    "url": "https://github.com/mpresecan/payload-solutions.git",
    "directory": "packages/consent-react"
  },
  "bugs": "https://github.com/mpresecan/payload-solutions/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next": {
      "import": "./src/next.ts",
      "types": "./src/next.ts",
      "default": "./src/next.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "registry",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@payload-solutions/consent-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./next": {
        "import": "./dist/next.js",
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
