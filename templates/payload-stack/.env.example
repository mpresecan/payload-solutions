# ---- Required ---------------------------------------------------------------
# Database. The CLI writes the adapter that matches this URL into payload.config.ts.
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/payload-stack
# Payload encryption/JWT secret. Also used by Better Auth unless BETTER_AUTH_SECRET is set.
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public origin of the app, no trailing slash. Used for links in emails and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Recommended --------------------------------------------------------------
# openssl rand -base64 32
# BETTER_AUTH_SECRET=

# ---- Email (Resend) -----------------------------------------------------------
# Without RESEND_API_KEY emails are logged to the console (fine for development).
# RESEND_API_KEY=re_...
# EMAIL_FROM=hello@yourdomain.com
# EMAIL_FROM_NAME=Your Product

# ---- Billing (Stripe) ---------------------------------------------------------
# Only needed when stack.config.ts has billing.provider = 'stripe'.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...      # stripe listen --forward-to localhost:3000/api/auth/stripe/webhook
# Price ids are public identifiers and are read by stack.config.ts.
# NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_STARTER_YEARLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_TEAM_MONTHLY=price_...
# NEXT_PUBLIC_STRIPE_PRICE_TEAM_YEARLY=price_...

# ---- Social sign-in -----------------------------------------------------------
# Only needed for providers listed in stack.config.ts under auth.social.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Media storage ------------------------------------------------------------
# Without an adapter, uploads are written to ./media on local disk: fine for development, lost on
# redeploy on Vercel and other ephemeral hosts. payload.config.ts reads only the adapter you chose
# in the CLI (or wired in yourself); its variables switch that adapter on.
# Vercel Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# AWS S3, or an S3-compatible service (MinIO, DigitalOcean Spaces, Backblaze B2: set S3_ENDPOINT)
# S3_BUCKET=
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# Cloudflare R2 (S3 API). R2_PUBLIC_URL is optional: a public bucket URL or custom domain, no trailing slash.
# R2_BUCKET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=
# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_NAME=
# AZURE_STORAGE_ACCOUNT_BASEURL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_ALLOW_CONTAINER_CREATE=false
# Google Cloud Storage. Locally, GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json; on hosts without a
# filesystem, paste the service-account key JSON into GCS_SERVICE_ACCOUNT_KEY instead.
# GCS_BUCKET=
# GCS_PROJECT_ID=
# GCS_SERVICE_ACCOUNT_KEY=
# Uploadthing
# UPLOADTHING_TOKEN=

# --- Error monitoring -------------------------------------------------------------------------
# Leave these unset and nothing is reported: no SDK reaches the browser and the server logs to the
# console in development. Set the DSN and both server and client start reporting.
# Works unchanged against sentry.io, a self-hosted Sentry, or GlitchTip.
# SENTRY_DSN=https://<key>@<host>/<project>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<host>/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=                        # git sha; CI usually sets this
# Build-time only: source map upload and the next.config wrapper.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
