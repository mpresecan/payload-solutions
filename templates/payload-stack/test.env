# Environment for the test suites (`pnpm test:int`, `pnpm test:e2e`).
#
# Loaded by tests/helpers/test-env.ts, which reads .env first and then this file with override, so
# the suites never run against your development database or your real secrets. A variable exported
# in the real environment still wins over both, which is how CI points them at its own containers.
#
# The databases are the `postgres-test` service in docker-compose.yml (published on 5433). Start it
# with `docker compose up -d`. Its data directory is tmpfs: every container start recreates both
# databases empty and Payload pushes the schema on boot.
NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"

# Integration tests.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/payload-stack-test

# End-to-end journeys. They start their own dev server on E2E_PORT against their own database, so
# they neither collide with `pnpm dev` on :3000 nor see the integration tests' data.
# Change E2E_PORT if something else on your machine already listens there.
E2E_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/payload-stack-e2e
E2E_PORT=3456

# Throwaway secrets so the suites run on a fresh clone without a .env. Never used in production.
PAYLOAD_SECRET=payload-stack-tests-not-a-real-secret
BETTER_AUTH_SECRET=payload-stack-tests-not-a-real-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
